[run]
branch = True
parallel = True

[paths]
pulumi =
    pulumi
    /workspace/pulumi
    */pulumi
    */pulumi-program
    */pulumi-managed-preview
    */pulumi-invalid-environment
    */pulumi-invalid-serviceName
policy =
    policy
    /workspace/policy
    */policy
scripts =
    scripts
    /workspace/scripts
    */scripts

[report]
show_missing = True
omit =
    */site-packages/*
