                      ]
                    },
                    {
                      "required": [
                        "bootstrap_job_role_arn"
                      ]
                    },
                    {
                      "required": [
                        "restore_operator_role_arn"
                      ]
                    },
                    {
                      "required": [
                        "restore_reader_role_arn"
                      ]
                    },
                    {
                      "required": [
                        "apply_role_arn"
                      ]
                    },
                    {
                      "required": [
                        "recovery_role_arn"
                      ]
                    },
                    {
                      "required": [
                        "exercise_role_arn"
                      ]
                    },
                    {
