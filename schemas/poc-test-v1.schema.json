{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vilnacrm:poc-test-contract:v1",
  "title": "Proposed TEST PoC ownership and release contract",
  "description": "Local shape constraints only; no approval, installation, receipt or runtime authenticity is established. Unknown owner inputs must be supplied before workload validation.",
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "source_sha",
        "reference"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "source_sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[0-9a-f]{40}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^https://github\\.com/VilnaCRM-Org/[A-Za-z0-9_.-]+/(?:issues|pull)/[1-9][0-9]*(?:#[A-Za-z0-9_-]+)?$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "archive_sha256",
        "file_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "integer",
          "minimum": 1
        },
        "archive_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "logical_name",
        "name",
        "arn",
        "uri"
      ],
      "properties": {
        "owner": {
          "const": "service"
        },
        "logical_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
        },
        "arn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^arn:aws:ecr:eu-central-1:891377212104:repository/[a-z0-9._/-]+$"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^891377212104\\.dkr\\.ecr\\.eu-central-1\\.amazonaws\\.com/[a-z0-9._/-]+$"
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kms_key_arn",
        "owner"
      ],
      "properties": {
        "kms_key_arn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^arn:aws:kms:eu-central-1:891377212104:key/[0-9a-f-]{36}$"
        },
        "owner": {
          "const": "service-generated"
        },
        "name": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^/user-service-infrastructure/runtime/test/[A-Za-z0-9/_+=.@-]+$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_uri",
        "digest",
        "target"
      ],
      "properties": {
        "repository_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target": {
          "enum": [
            "frankenphp_prod",
            "app_workers"
          ]
        }
      }
    },
    "workload_role_arn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^arn:aws:iam::891377212104:role/[A-Za-z0-9_+=,.@/-]+$"
    },
    "lambda_function_arn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^arn:aws:lambda:eu-central-1:891377212104:function:[A-Za-z0-9_-]{1,64}$"
    },
    "function_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "cmk_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arn",
        "alias"
      ],
      "properties": {
        "arn": {
          "type": "string",
          "minLength": 78,
          "maxLength": 78,
          "pattern": "^arn:aws:kms:eu-central-1:891377212104:key/[0-9a-f-]{36}$"
        },
        "alias": {
          "type": "string",
          "minLength": 7,
          "maxLength": 256,
          "pattern": "^alias/[A-Za-z0-9/_-]+$"
        }
      }
    },
    "value_kind": {
      "enum": [
        "hex-256",
        "base64-256",
        "rsa-4096-private-pem",
        "rsa-4096-public-pem"
      ]
    },
    "rotation_function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_ref",
        "schedule_days"
      ],
      "properties": {
        "function_ref": {
          "$ref": "#/$defs/function_ref"
        },
        "schedule_days": {
          "const": 90
        }
      }
    },
    "rotated_secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kms_key_arn",
        "owner",
        "rotation",
        "value_kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^/user-service-infrastructure/runtime/test/[A-Za-z0-9/_+=.@-]+$"
        },
        "kms_key_arn": {
          "type": "string",
          "minLength": 78,
          "maxLength": 78,
          "pattern": "^arn:aws:kms:eu-central-1:891377212104:key/[0-9a-f-]{36}$"
        },
        "owner": {
          "const": "service-seeded"
        },
        "value_kind": {
          "$ref": "#/$defs/value_kind"
        },
        "rotation": {
          "$ref": "#/$defs/rotation_function"
        }
      }
    },
    "interim_secret": {
      "description": "A KMS-bound purpose kept declared until its KMS move; gate 1 rejects it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kms_key_arn",
        "owner",
        "rotation",
        "value_kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^/user-service-infrastructure/runtime/test/[A-Za-z0-9/_+=.@-]+$"
        },
        "kms_key_arn": {
          "type": "string",
          "minLength": 78,
          "maxLength": 78,
          "pattern": "^arn:aws:kms:eu-central-1:891377212104:key/[0-9a-f-]{36}$"
        },
        "owner": {
          "const": "service-seeded"
        },
        "value_kind": {
          "$ref": "#/$defs/value_kind"
        },
        "rotation": {
          "const": "non_rotatable"
        }
      }
    },
    "legacy_secret_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "namespace",
        "generation",
        "guard_amendment",
        "provider_refresh_actions",
        "review",
        "references"
      ],
      "properties": {
        "owner": {
          "const": "service"
        },
        "namespace": {
          "const": "/user-service-infrastructure/runtime/test/"
        },
        "generation": {
          "const": "generate-once-persist-explicit-rotation"
        },
        "guard_amendment": {
          "const": "pending-independent-reviewed-amendment"
        },
        "provider_refresh_actions": {
          "const": [
            "secretsmanager:GetSecretValue"
          ]
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_db_password",
            "redis_auth_token",
            "app_secret",
            "oauth_encryption_key",
            "oauth_passphrase",
            "two_factor_encryption_key",
            "oauth_private_key",
            "oauth_public_key",
            "document_db_url",
            "redis_url"
          ],
          "properties": {
            "document_db_password": {
              "$ref": "#/$defs/secret"
            },
            "redis_auth_token": {
              "$ref": "#/$defs/secret"
            },
            "app_secret": {
              "$ref": "#/$defs/secret"
            },
            "oauth_encryption_key": {
              "$ref": "#/$defs/secret"
            },
            "oauth_passphrase": {
              "$ref": "#/$defs/secret"
            },
            "two_factor_encryption_key": {
              "$ref": "#/$defs/secret"
            },
            "oauth_private_key": {
              "$ref": "#/$defs/secret"
            },
            "oauth_public_key": {
              "$ref": "#/$defs/secret"
            },
            "document_db_url": {
              "$ref": "#/$defs/secret"
            },
            "redis_url": {
              "$ref": "#/$defs/secret"
            }
          }
        }
      }
    },
    "hardened_secret_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "namespace",
        "generation",
        "guard_amendment",
        "review",
        "references"
      ],
      "properties": {
        "owner": {
          "const": "service"
        },
        "namespace": {
          "const": "/user-service-infrastructure/runtime/test/"
        },
        "generation": {
          "const": "rotation-seed"
        },
        "guard_amendment": {
          "const": "pending-independent-reviewed-amendment"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app_secret",
            "oauth_encryption_key"
          ],
          "properties": {
            "app_secret": {
              "allOf": [
                {
                  "$ref": "#/$defs/rotated_secret"
                },
                {
                  "properties": {
                    "value_kind": {
                      "const": "hex-256"
                    }
                  }
                }
              ]
            },
            "oauth_encryption_key": {
              "allOf": [
                {
                  "$ref": "#/$defs/rotated_secret"
                },
                {
                  "properties": {
                    "value_kind": {
                      "const": "hex-256"
                    }
                  }
                }
              ]
            },
            "oauth_passphrase": {
              "allOf": [
                {
                  "$ref": "#/$defs/interim_secret"
                },
                {
                  "properties": {
                    "value_kind": {
                      "const": "hex-256"
                    }
                  }
                }
              ]
            },
            "two_factor_encryption_key": {
              "allOf": [
                {
                  "$ref": "#/$defs/interim_secret"
                },
                {
                  "properties": {
                    "value_kind": {
                      "const": "base64-256"
                    }
                  }
                }
              ]
            },
            "oauth_private_key": {
              "allOf": [
                {
                  "$ref": "#/$defs/interim_secret"
                },
                {
                  "properties": {
                    "value_kind": {
                      "const": "rsa-4096-private-pem"
                    }
                  }
                }
              ]
            },
            "oauth_public_key": {
              "allOf": [
                {
                  "$ref": "#/$defs/interim_secret"
                },
                {
                  "properties": {
                    "value_kind": {
                      "const": "rsa-4096-public-pem"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "operation_phase": {
      "enum": [
        "stop",
        "hold",
        "start"
      ]
    },
    "resumed_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "first",
            "step2",
            "rollback-zero",
            "policy-update",
            "rebuild-first"
          ]
        },
        "phase": {
          "$ref": "#/$defs/operation_phase"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "rollback-zero"
              }
            }
          },
          "then": {
            "required": [
              "phase"
            ]
          },
          "else": {
            "not": {
              "required": [
                "phase"
              ]
            }
          }
        }
      ]
    },
    "workload_operation": {
      "description": "Reviewed operation of this contract. Recovery modes come only from the recovery workflow.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "sequence"
      ],
      "properties": {
        "mode": {
          "enum": [
            "first",
            "step2",
            "resume",
            "rollback-zero",
            "policy-update",
            "rebuild-first"
          ]
        },
        "phase": {
          "$ref": "#/$defs/operation_phase"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "resumes": {
          "$ref": "#/$defs/resumed_operation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "rollback-zero"
              }
            }
          },
          "then": {
            "required": [
              "phase"
            ]
          },
          "else": {
            "not": {
              "required": [
                "phase"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "resume"
              }
            }
          },
          "then": {
            "required": [
              "resumes"
            ]
          },
          "else": {
            "not": {
              "required": [
                "resumes"
              ]
            }
          }
        }
      ]
    },
    "scaling_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "at"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "at": {
          "description": "UTC time of the one-time action, rendered as at(<at>).",
          "type": "string",
          "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts",
        "stops",
        "consumed"
      ],
      "properties": {
        "starts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/scaling_action"
          }
        },
        "stops": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/scaling_action"
          }
        },
        "consumed": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:start|stop)-[1-9][0-9]{0,5}$"
          }
        },
        "scheduled_scaling_suspended": {
          "description": "Persistent TEST-only hold flag; absent means false.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "prod"
      ],
      "properties": {
        "test": {
          "type": "boolean"
        },
        "prod": {
          "enum": [
            false,
            "preview",
            true
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "environment",
    "account_id",
    "region",
    "backend",
    "source",
    "prerequisites",
    "registries",
    "phase",
    "mail_identity"
  ],
  "properties": {
    "schema_version": {
      "const": "poc-test-v1"
    },
    "status": {
      "const": "proposed-not-installed"
    },
    "environment": {
      "const": "test"
    },
    "account_id": {
      "const": "891377212104"
    },
    "region": {
      "const": "eu-central-1"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "stack",
        "url",
        "secrets_provider",
        "owner"
      ],
      "properties": {
        "project": {
          "const": "user-service-infrastructure"
        },
        "stack": {
          "const": "test"
        },
        "url": {
          "const": "s3://pulumi-user-service-infrastructure-test-state"
        },
        "secrets_provider": {
          "const": "awskms://alias/pulumi-user-service-infrastructure-test-secrets?region=eu-central-1"
        },
        "owner": {
          "const": "central-governance"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "owner_id"
      ],
      "properties": {
        "repository": {
          "const": "VilnaCRM-Org/user-service-infrastructure"
        },
        "repository_id": {
          "const": 911736693
        },
        "owner_id": {
          "const": 114362548
        }
      }
    },
    "prerequisites": {
      "const": [
        "independent-seed-and-boundary-enrollment-pending",
        "runtime-secret-guard-amendment-pending",
        "actual-service-main-controller-trust-installation-pending",
        "application-runtime-repair-and-live-acceptance-pending"
      ]
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web",
        "worker"
      ],
      "properties": {
        "web": {
          "$ref": "#/$defs/registry"
        },
        "worker": {
          "$ref": "#/$defs/registry"
        }
      }
    },
    "phase": {
      "enum": [
        "registry",
        "workload"
      ]
    },
    "central": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "inventory_sha256",
        "seed_enrollment_revision",
        "publisher_role_arn",
        "publisher_workflow_path",
        "publisher_environment",
        "publisher_claim_kind"
      ],
      "properties": {
        "owner": {
          "const": "central-governance"
        },
        "inventory_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed_enrollment_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[0-9a-f]{64}$"
        },
        "publisher_role_arn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^arn:aws:iam::891377212104:role/[A-Za-z0-9_+=,.@/-]+$"
        },
        "publisher_workflow_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\.github/workflows/[A-Za-z0-9_-]+\\.yml$"
        },
        "publisher_environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "publisher_claim_kind": {
          "const": "ordinary-workflow-protected-environment"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "central",
        "release",
        "external",
        "secret_lifecycle",
        "service_components",
        "runtime"
      ],
      "properties": {
        "central": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "inventory_sha256",
            "seed_enrollment_revision",
            "publisher_role_arn",
            "publisher_workflow_path",
            "publisher_environment",
            "publisher_claim_kind",
            "execution_role_arn",
            "task_role_arn"
          ],
          "properties": {
            "owner": {
              "const": "central-governance"
            },
            "inventory_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[0-9a-f]{64}$"
            },
            "seed_enrollment_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[0-9a-f]{64}$"
            },
            "publisher_role_arn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^arn:aws:iam::891377212104:role/[A-Za-z0-9_+=,.@/-]+$"
            },
            "publisher_workflow_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^\\.github/workflows/[A-Za-z0-9_-]+\\.yml$"
            },
            "publisher_environment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "publisher_claim_kind": {
              "const": "ordinary-workflow-protected-environment"
            },
            "execution_role_arn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^arn:aws:iam::891377212104:role/[A-Za-z0-9_+=,.@/-]+$"
            },
            "task_role_arn": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^arn:aws:iam::891377212104:role/[A-Za-z0-9_+=,.@/-]+$"
            },
            "app_rotation_role_arn": {
              "$ref": "#/$defs/workload_role_arn"
            },
            "redeploy_role_arn": {
              "$ref": "#/$defs/workload_role_arn"
            },
            "bootstrap_job_role_arn": {
              "$ref": "#/$defs/workload_role_arn"
            },
            "restore_operator_role_arn": {
              "$ref": "#/$defs/workload_role_arn"
            },
            "restore_reader_role_arn": {
              "$ref": "#/$defs/workload_role_arn"
