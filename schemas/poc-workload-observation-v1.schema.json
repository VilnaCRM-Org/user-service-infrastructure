{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vilnacrm:poc-workload-observation:v1",
  "title": "Workload start or stop observation bound to one success receipt",
  "description": "Local shape only. Publication, issuer, run binding and checkpoint authenticity are established by the receipt library, never by this schema. Metadata only: no secret value, resource input or resource output appears. A start record shows every service steady with running tasks, healthy targets and a green health endpoint; a stop record shows zero tasks and every target at min = max = 0.",
  "$comment": "Draft 2020-12 pattern is applied with re.search, so '$' also matches before a trailing newline. Fixed-length fields pin minLength = maxLength; the S4.11 receipt library must re-check every variable-length field with re.fullmatch.",
  "$defs": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "etag",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "not": {
            "const": "null"
          }
        },
        "etag": {
          "type": "string",
          "minLength": 34,
          "maxLength": 34,
          "pattern": "^\"[0-9a-f]{32}\"$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "stack": {
      "enum": [
        "test",
        "prod"
      ]
    },
    "success_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "run_id",
        "run_attempt",
        "checkpoint_sha256"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/positive_integer"
        },
        "run_id": {
          "$ref": "#/$defs/positive_integer"
        },
        "run_attempt": {
          "$ref": "#/$defs/positive_integer"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scaling_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "at"
      ],
      "properties": {
        "seq": {
          "$ref": "#/$defs/positive_integer"
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        }
      }
    },
    "started_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired_count",
        "running_count",
        "steady_state",
        "targets_healthy"
      ],
      "properties": {
        "desired_count": {
          "type": "integer",
          "minimum": 1
        },
        "running_count": {
          "type": "integer",
          "minimum": 1
        },
        "steady_state": {
          "const": true
        },
        "targets_healthy": {
          "const": true
        }
      }
    },
    "stopped_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired_count",
        "running_count",
        "min_capacity",
        "max_capacity"
      ],
      "properties": {
        "desired_count": {
          "const": 0
        },
        "running_count": {
          "const": 0
        },
        "min_capacity": {
          "const": 0
        },
        "max_capacity": {
          "const": 0
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stack",
    "kind",
    "success_receipt",
    "checkpoint",
    "action",
    "observed_at",
    "services"
  ],
  "properties": {
    "schema_version": {
      "const": "poc-workload-observation-v1"
    },
    "stack": {
      "$ref": "#/$defs/stack"
    },
    "kind": {
      "enum": [
        "start",
        "stop"
      ]
    },
    "success_receipt": {
      "$ref": "#/$defs/success_binding"
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "action": {
      "$ref": "#/$defs/scaling_action"
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "services": {
      "type": "object"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "const": "/api/health"
        },
        "status": {
          "const": 204
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "start"
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "web",
            "worker"
          ],
          "properties": {
            "web": {
              "$ref": "#/$defs/started_service"
            },
            "worker": {
              "$ref": "#/$defs/started_service"
            }
          }
        }
      },
      "required": [
        "health"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "stop"
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "web",
            "worker"
          ],
          "properties": {
            "web": {
              "$ref": "#/$defs/stopped_service"
            },
            "worker": {
              "$ref": "#/$defs/stopped_service"
            }
          }
        }
      },
      "not": {
        "required": [
          "health"
        ]
      }
    }
  ]
}
